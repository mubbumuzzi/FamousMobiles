# Copy to .env on your server and fill in real values:
# cp .env.production.example .env

# === REQUIRED: change all secrets before going live ===

# Your domain (no trailing slash)
PUBLIC_APP_URL=https://app.famousmobiles.com

# API URL seen by the browser (must match your domain)
NEXT_PUBLIC_API_URL=https://app.famousmobiles.com/api

# CORS — include your domain
CORS_ORIGINS=https://app.famousmobiles.com

# Database — use strong passwords
DB_USER=famousmobiles
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

# JWT — generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_GENERATE_A_LONG_RANDOM_JWT_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_A_LONG_RANDOM_REFRESH_SECRET

# Admin seed (only used on first startup)
ADMIN_EMAIL=admin@famousmobiles.com
ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
